# Eter News Public Portal Environment Config
PORT=5177
DATABASE_URL=postgres://user:password@host:5432/dbname

# Admin key — password for the /admin Gather Monitor dashboard and the
# x-hub-key header on /api/admin/*. Unset = the dashboard stays locked.
HUB_API_KEY=

# --- News engine -----------------------------------------------------------
# Tavily search (news discovery + page text).
TAVILY_API_KEY=

# OpenAI-compatible LLM router used to write the bilingual articles.
LLM_BASE_URL=https://e-router.up.railway.app/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash

# Set to "false" to run the portal only (no scheduler). Manual runs from
# /admin still work.
ENGINE_ENABLED=true
