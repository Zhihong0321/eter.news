# Eter News Public Portal Environment Config
PORT=5177
DATABASE_URL=postgres://user:password@host:5432/dbname

# Everything below is OPTIONAL. The admin password and API keys are set from
# the /admin first-run setup page and stored in PostgreSQL.
# Optional extra admin password / x-hub-key header:
HUB_API_KEY=

# --- News engine -----------------------------------------------------------
# Tavily search (news discovery + page text).
TAVILY_API_KEY=  # one key, or several separated by commas (round-robin)

# OpenAI-compatible LLM router used to write the bilingual articles.
LLM_BASE_URL=https://e-router.up.railway.app/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash

# Set to "false" to run the portal only (no scheduler). Manual runs from
# /admin still work.
ENGINE_ENABLED=true
