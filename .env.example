# Eter News Public Portal Environment Config
PORT=5177
DATABASE_URL=postgres://user:password@host:5432/dbname

# Hub API — protects /api/hub/* (existing-urls, persist-articles,
# stage-status, debug/status). Unset = those endpoints stay locked. A remote
# fetcher (news-fetcher-v2, running off Railway) sends this as the x-hub-key
# header instead of holding its own DATABASE_URL, so Postgres traffic never
# leaves Railway's private network.
HUB_API_KEY=
